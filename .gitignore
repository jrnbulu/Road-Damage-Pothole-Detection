# Data: raw downloads stay local (zips exceed GitHub's 100 MB file limit);
# the processed RDD2022 India set (~130 MB of small images) is committed.
/data/raw/
/data/processed/*
!/data/processed/rdd_india/
/runs/
*.zip
*.part

# Weights: commit only the final trained models (small .pt files)
models/*
!models/.gitkeep
!models/best.pt
!models/baseline_yolov8n.pt
!models/advanced_yolov8s_india.pt
/yolov8*.pt
/yolo11*.pt
*.onnx
*_saved_model/

# Evaluation scratch runs (confidence sweep)
reports/eval/conf_*/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Secrets
.env
